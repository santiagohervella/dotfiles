{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.5",
  "mcp": {
    "linear": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-remote",
        "https://mcp.linear.app/mcp"
      ]
    },
    "mcp-server-datadog": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@winor30/mcp-server-datadog"
      ],
      "environment": {
        "DATADOG_API_KEY": "${DATADOG_API_KEY}",
        "DATADOG_APP_KEY": "${DATADOG_APP_KEY}",
        "DATADOG_SITE": "datadoghq.com"
      }
    },
    "pagerduty": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-remote",
        "https://mcp.pagerduty.com/mcp",
        "--header",
        "Authorization:Token token=${PAGERDUTY_API_TOKEN}"
      ]
    },
    "catena": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-remote",
        "https://docs.catenatelematics.com/mcp"
      ]
    },
    "samsara": {
      "type": "remote",
      "url": "https://sammcp.playground.samsaradev.io/mcp",
      "headers": {
        "Authorization": "Bearer ${SAMSARA_API_KEY}"
      }
    }
  },
  "permission": {
    "*": "ask",
    "task": "allow",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "external_directory": "allow",
    "websearch": "allow",
    "webfetch": "ask",
    "todowrite": "allow",
    "bash": {
      "*": "ask",
      "ansible-doc*": "allow",
      "ansible-galaxy collection list*": "allow",
      "aws dynamodb describe-table*": "allow",
      "aws dynamodb get-item*": "allow",
      "aws dynamodb list-tables*": "allow",
      "aws lambda get-function-configuration*": "allow",
      "aws lambda list-functions*": "allow",
      "aws logs describe-log-streams*": "allow",
      "aws logs filter-log-events*": "allow",
      "aws logs get-log-events*": "allow",
      "aws opensearch describe-domain*": "allow",
      "aws opensearch list-domain-names*": "allow",
      "aws sso login*": "allow",
      "cat*": "allow",
      "cd*": "allow",
      "date*": "allow",
      "find*": "allow",
      "gh pr checks*": "allow",
      "gh pr diff*": "allow",
      "gh pr list*": "allow",
      "gh pr view*": "allow",
      "gh repo view*": "allow",
      "gh run view*": "allow",
      "gh search code*": "allow",
      "gh search issues*": "allow",
      "gh search prs*": "allow",
      "git add*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git status*": "allow",
      "grep*": "allow",
      "head*": "allow",
      "ls*": "allow",
      "mason search*": "allow",
      "npm ls*": "allow",
      "npm run*": "allow",
      "npm test*": "allow",
      "npm view*": "allow",
      "npx generate*": "allow",
      "npx tsc*": "allow",
      "npx vitest*": "allow",
      "nr*": "allow",
      "pbcopy*": "allow",
      "pbpaste*": "allow",
      "poetry run black*": "allow",
      "poetry run pytest*": "allow",
      "poetry run python -m pytest*": "allow",
      "poetryinstall": "allow",
      "readlink*": "allow",
      "sketchybar --reload": "allow",
      "sort*": "allow",
      "swift build*": "allow",
      "swift test:*": "allow",
      "tail*": "allow",
      "tmux capture-pane*": "allow",
      "tmux has-session*": "allow",
      "tmux list-keys*": "allow",
      "tmux list-panes*": "allow",
      "tmux list-sessions*": "allow",
      "tmux list-windows*": "allow",
      "tree*": "allow",
      "uniq*": "allow",
      "wc*": "allow",
      "xargs grep*": "allow"
    },
    "claude_ai_Figma_get_design_context": "allow",
    "claude_ai_Linear_list_issue_statuses": "allow",
    "claude_ai_Linear_list_teams": "allow",
    "claude_ai_Linear_list_users": "allow",
    "claude_ai_Linear_list_issue_labels": "allow",
    "claude_ai_Slack_slack_read_channel": "allow",
    "claude_ai_Slack_slack_read_thread": "allow",
    "claude_ai_Slack_slack_search_public": "allow",
    "claude_ai_Slack_slack_search_public_and_private": "allow",
    "linear_get_issue": "allow",
    "linear_list_teams": "allow",
    "linear_list_users": "allow",
    "linear_list_issue_statuses": "allow",
    "mcp-server-datadog_get_*": "allow",
    "mcp-server-datadog_list_*": "allow",
    "mcp-server-datadog_query_*": "allow"
  },
  "agent": {
    "build": {
      "reasoningEffort": "medium",
      "textVerbosity": "low"
    },
    "plan": {
      "reasoningEffort": "high",
      "textVerbosity": "low",
      "permission": {
        "edit": "deny",
        "bash": "ask"
      }
    }
  }
}
