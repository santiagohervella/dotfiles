<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Managed by Ansible (tasks/arr.yml). Edit the template in the dotfiles repo, not this file. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>{{ item.label }}</string>

  <key>ProgramArguments</key>
  <array>
    <string>{{ item.program }}</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>{{ item.hour }}</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <!-- launchd can't write to removable volumes, so logs stay on the internal disk -->
  <key>StandardOutPath</key>
  <string>{{ ansible_env.HOME }}/Library/Logs/{{ item.log }}.log</string>
  <key>StandardErrorPath</key>
  <string>{{ ansible_env.HOME }}/Library/Logs/{{ item.log }}.log</string>
</dict>
</plist>
