{
  "alwaysThinkingEnabled": true,
  "enableAllProjectMcpServers": true,
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.config/tmux/plugins/tmux-assistant-resurrect/hooks/claude-session-cleanup.sh\"",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.config/tmux/plugins/tmux-assistant-resurrect/hooks/claude-session-track.sh\"",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  },
  "model": "claude-fable-5[1m]",
  "permissions": {
    "allow": [
      "Agent",
      "Bash(ansible-doc*)",
      "Bash(ansible-galaxy collection list*)",
      "Bash(aws dynamodb describe-table*)",
      "Bash(aws dynamodb get-item*)",
      "Bash(aws dynamodb list-tables*)",
      "Bash(aws lambda get-function-configuration*)",
      "Bash(aws lambda list-functions*)",
      "Bash(aws logs describe-log-streams*)",
      "Bash(aws logs filter-log-events*)",
      "Bash(aws logs get-log-events*)",
      "Bash(aws opensearch describe-domain*)",
      "Bash(aws opensearch list-domain-names*)",
      "Bash(aws sso login*)",
      "Bash(cat*)",
      "Bash(cd*)",
      "Bash(date*)",
      "Bash(find*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr list*)",
      "Bash(gh pr view*)",
      "Bash(gh repo view*)",
      "Bash(gh run view*)",
      "Bash(gh search code*)",
      "Bash(gh search issues*)",
      "Bash(gh search prs*)",
      "Bash(git add*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git status*)",
      "Bash(grep*)",
      "Bash(head*)",
      "Bash(ls*)",
      "Bash(mason search*)",
      "Bash(npm ls*)",
      "Bash(npm run*)",
      "Bash(npm test*)",
      "Bash(npm view*)",
      "Bash(npx generate*)",
      "Bash(npx tsc*)",
      "Bash(npx vitest*)",
      "Bash(nr*)",
      "Bash(pbcopy*)",
      "Bash(pbpaste*)",
      "Bash(poetry run black*)",
      "Bash(poetry run pytest*)",
      "Bash(poetry run python -m pytest*)",
      "Bash(poetryinstall)",
      "Bash(readlink*)",
      "Bash(sketchybar --reload)",
      "Bash(sort*)",
      "Bash(swift build*)",
      "Bash(swift test:*)",
      "Bash(tail*)",
      "Bash(tmux capture-pane*)",
      "Bash(tmux has-session*)",
      "Bash(tmux list-keys*)",
      "Bash(tmux list-panes*)",
      "Bash(tmux list-sessions*)",
      "Bash(tmux list-windows*)",
      "Bash(tree*)",
      "Bash(uniq*)",
      "Bash(wc*)",
      "Bash(xargs grep*)",
      "Bash(~/.claude/skills/catch-me-up/scripts/*)",
      "Glob",
      "Grep",
      "Read",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:mason-registry.dev)",
      "WebFetch(domain:opencode.ai)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebSearch",
      "mcp__claude_ai_Figma__get_design_context",
      "mcp__claude_ai_Linear__list_issue_statuses",
      "mcp__claude_ai_Linear__list_teams",
      "mcp__claude_ai_Linear__list_users",
      "mcp__claude_ai_Linear__list_issue_labels",
      "mcp__claude_ai_Slack__slack_read_channel",
      "mcp__claude_ai_Slack__slack_read_thread",
      "mcp__claude_ai_Slack__slack_search_public",
      "mcp__claude_ai_Slack__slack_search_public_and_private",
      "mcp__linear__get_issue",
      "mcp__linear__list_teams",
      "mcp__linear__list_users",
      "mcp__linear__list_issue_statuses",
      "mcp__mcp-server-datadog__get_*",
      "mcp__mcp-server-datadog__list_*",
      "mcp__mcp-server-datadog__query_*"
    ],
    "defaultMode": "auto",
    "deny": []
  },
  "skipAutoPermissionPrompt": true,
  "statusLine": {
    "command": "bash \"$HOME/.claude/statusline.sh\"",
    "type": "command"
  },
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "voiceEnabled": true
}
